	\EucDiv. EucDiv A B
		\Q.\R. (lt sa Zero)
			((eq Zero R)
				(Pair (Mul (Mul sb sa) Q) Zero)
				(Pair (Mul (Mul sb sa) (Succ Q)) (Sub B R)))
			(Pair (Mul sb Q) R)
